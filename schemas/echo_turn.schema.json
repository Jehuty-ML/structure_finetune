{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/echo_turn.schema.json",
  "title": "EchoVoiceTurn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "utter",
    "emotion",
    "volume",
    "pace",
    "should_speak",
    "intent",
    "ui_mode",
    "end_turn"
  ],
  "properties": {
    "utter": {
      "type": "string",
      "minLength": 1,
      "description": "仅 TTS 安全的口播文本"
    },
    "emotion": {
      "type": "string",
      "enum": ["gentle", "cheerful", "calm", "concerned", "playful", "neutral"]
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "pace": {
      "type": "string",
      "enum": ["slow", "normal", "fast"]
    },
    "should_speak": {
      "type": "boolean"
    },
    "intent": {
      "type": "string",
      "enum": [
        "comfort",
        "celebrate",
        "clarify",
        "chat",
        "joke",
        "close",
        "interrupt_ack"
      ],
      "description": "客户端路由/UI 意图"
    },
    "ui_mode": {
      "type": "string",
      "enum": ["speak", "text_only", "listen"],
      "description": "界面模式：语音播报 / 仅文字 / 聆听"
    },
    "end_turn": {
      "type": "boolean"
    }
  }
}
